erDiagram
    USER ||--o{ PROJECT : owns
    USER ||--o{ SESSION : "has (refresh tokens)"
    USER ||--o{ PUSH_TOKEN : registers
    USER ||--o{ AUDIT_LOG : triggers
    PROJECT ||--o{ TASK : contains
    TASK ||--o{ NOTIFICATION_LOG : "dedupe record"

    USER {
        uuid id PK
        string full_name
        string email UK
        string password_hash
        enum role "USER | ADMIN"
    }
    SESSION {
        uuid id PK
        uuid user_id FK
        string token_hash UK
        string family_id
        datetime expires_at
        datetime revoked_at
    }
    PROJECT {
        uuid id PK
        uuid owner_id FK
        string name
        enum status "NOT_STARTED | IN_PROGRESS | COMPLETED"
        date start_date
        date end_date
    }
    TASK {
        uuid id PK
        uuid project_id FK
        string name
        enum priority "LOW | MEDIUM | HIGH"
        enum status "PENDING | IN_PROGRESS | COMPLETED"
        date due_date
    }
    PUSH_TOKEN {
        uuid id PK
        uuid user_id FK
        string token UK
        enum platform "ANDROID | IOS"
    }
    NOTIFICATION_LOG {
        uuid id PK
        uuid task_id FK
        string kind
        date due_date
    }
    AUDIT_LOG {
        uuid id PK
        uuid user_id FK
        string action
        string entity_type
        uuid entity_id
    }

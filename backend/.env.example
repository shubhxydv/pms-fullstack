NODE_ENV=development
PORT=4000

# Local dev: docker-compose.dev.yml postgres service
DATABASE_URL=postgresql://pms:pms_dev_password@localhost:5432/pms?schema=public
# Neon: direct (non-pooled) connection used for migrations. Local dev: same as DATABASE_URL.
DIRECT_URL=postgresql://pms:pms_dev_password@localhost:5432/pms?schema=public

# openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_random_64_char_hex_string_min_32_chars

CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# openssl rand -hex 16
CRON_SECRET=replace_with_a_random_secret

APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# Push notifications (FCM v1). Optional — unset means push sending no-ops with a warning.
# Local dev: drop the downloaded service-account JSON at backend/secrets/firebase-service-account.json
# (gitignored) and leave FIREBASE_SERVICE_ACCOUNT_JSON unset; FIREBASE_SERVICE_ACCOUNT_PATH defaults to that path.
# Production (Render): paste the service-account JSON as a single-line string into this var instead.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
